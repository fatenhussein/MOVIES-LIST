# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/movies_list?schema=public"

# development | production
NODE_ENV=development

# Port the API listens on (defaults to 3001)
PORT=3001

# Secret used to sign JWTs. Use a long random string, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
