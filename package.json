{
  "name": "movies-list",
  "version": "1.0.0",
  "description": "REST API for managing movies and personal watchlists, built with Express 5, TypeScript, Prisma and PostgreSQL",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc",
    "db:migrate": "prisma migrate dev",
    "seed:movies": "tsx prisma/seed.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma skills sync || exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatenhussein/MOVIES-LIST.git"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "rest-api",
    "jwt",
    "zod"
  ],
  "author": "Faten Hussein",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/fatenhussein/MOVIES-LIST/issues"
  },
  "homepage": "https://github.com/fatenhussein/MOVIES-LIST#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
